---
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;

const navItems = [
  { title: '시작하기', links: [
    { text: "'하자'는 이런 언어예요!", href: '/docs/intro' },
  ]},
  { title: '기본 문법 튜토리얼', links: [
    { text: '1. 데이터 담기 (변수)', href: '/docs/tutorial/1-variables' },
    { text: '2. 계산하기 (연산)', href: '/docs/tutorial/2-math' },
    { text: '3. 글자 다루기 (문자열)', href: '/docs/tutorial/3-strings' },
    { text: '4. 조건문 (만약 ~라면)', href: '/docs/tutorial/4-conditions' },
    { text: '5. 스위치 (조건 분기)', href: '/docs/tutorial/5-switch' },
    { text: '6. 묶음 데이터 (배열, 사전)', href: '/docs/tutorial/6-collections' },
    { text: '7. 반복문 (반복하자)', href: '/docs/tutorial/7-loops' },
    { text: '8. 함수 (기능 만들기)', href: '/docs/tutorial/8-functions' },
    { text: '9. 에러 처리하기 (예외 처리)', href: '/docs/tutorial/9-errors' },
  ]},
  { title: '객체지향 문법', links: [
    { text: '1. 클래스 (설계도)', href: '/docs/oop/1-classes' },
    { text: '2. 접근 제한자 (비밀과 공개)', href: '/docs/oop/2-access-modifiers' },
    { text: '3. 상속 (부모님께 물려받기)', href: '/docs/oop/3-inheritance' },
    { text: '4. 인터페이스 (뼈대 약속)', href: '/docs/oop/4-interfaces' },
  ]},
  { title: '기술 명세서 (Spec)', links: [
    { text: '1. 언어 개요 및 문법', href: '/docs/tech-spec/1-overview' },
    { text: '2. 구문 트리(AST) 구조', href: '/docs/tech-spec/2-ast' },
    { text: '3. 실행기 및 런타임', href: '/docs/tech-spec/3-runtime' },
  ]}
];
---

<Layout title={`${frontmatter.title} | 하자(Haja) 언어`}>
  <div class="flex flex-col md:flex-row gap-12 mt-10">
    <aside class="w-full md:w-48 shrink-0 border-b md:border-b-0 border-zinc-200 pb-8 md:pb-0">
      <div class="sticky top-12 space-y-8">
        {navItems.map((section) => (
          <div>
            <h4 class="font-bold text-black mb-3 text-sm tracking-tight">{section.title}</h4>
            <ul class="space-y-2.5">
              {section.links.map((link) => {
                const isActive = Astro.url.pathname === link.href || Astro.url.pathname === link.href + '/';
                return (
                  <li>
                    <a 
                      href={link.href} 
                      class={`text-sm block transition-colors ${isActive ? 'text-black font-semibold' : 'text-zinc-500 hover:text-black'}`}
                    >
                      {link.text}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}

        <button 
          id="open-side-playground"
          class="w-full mt-6 bg-zinc-900 text-white px-4 py-2.5 rounded-lg text-sm font-medium hover:bg-zinc-800 transition-colors flex items-center justify-center gap-2 shadow-sm"
        >
          직접 실행해보기
        </button>
      </div>
    </aside>
    
    <article class="prose max-w-none flex-grow pb-24 doc-article">
      <h1 class="!mt-0">{frontmatter.title}</h1>
      <p class="text-xl text-zinc-500 font-light !mb-12 !mt-0 leading-relaxed border-b border-zinc-100 pb-12">{frontmatter.description}</p>
      <slot />
    </article>
  </div>

  <!-- Side Playground Overlay -->
  <div id="side-playground-drawer" class="fixed top-0 right-0 w-0 h-full bg-white border-l border-zinc-200 z-40 transition-all duration-300 flex flex-col shadow-2xl overflow-hidden">
    <div class="flex items-center justify-between px-4 py-3 border-b border-zinc-200 bg-zinc-50 shrink-0">
      <h3 class="font-bold text-sm">놀이터 (Playground)</h3>
      <div class="flex gap-2">
        <button id="side-run-btn" class="text-xs bg-blue-600 text-white px-4 py-1.5 rounded hover:bg-blue-700 font-semibold transition-colors">실행</button>
        <button id="side-close-btn" class="text-xs bg-zinc-200 text-zinc-700 px-3 py-1.5 rounded hover:bg-zinc-300 font-semibold transition-colors">닫기</button>
      </div>
    </div>
    <div id="side-editor" class="flex-grow w-full overflow-hidden flex flex-col min-h-0 bg-white"></div>
    <div class="h-[40%] bg-[#1E1E1E] flex flex-col shrink-0 border-t border-zinc-800">
      <div class="bg-[#2D2D2D] px-4 py-1.5 border-b border-zinc-700 text-xs font-semibold text-zinc-400 font-mono flex items-center gap-2 shrink-0">
        <div class="w-2 h-2 rounded-full bg-zinc-500"></div>터미널
      </div>
      <pre id="side-output" class="p-4 text-[13.5px] text-zinc-300 font-mono whitespace-pre-wrap leading-relaxed overflow-y-auto flex-grow m-0">코드를 작성하고 '실행' 버튼을 눌러보세요.</pre>
    </div>
  </div>

  <script>
    import { runHaja } from '../utils/haja';
    import { EditorView, basicSetup } from "codemirror";
    import { hajaLanguage } from '../utils/haja/cm-language';

    document.addEventListener("DOMContentLoaded", () => {

const createInputCallback = (outputContainer) => (promptText) => {
  return new Promise((resolve) => {
    if (!outputContainer) { resolve(""); return; }
    const promptSpan = document.createElement("span");
    promptSpan.innerText = promptText;
    promptSpan.className = "text-yellow-400";
    
    const inputWrapper = document.createElement("span");
    inputWrapper.className = "relative inline-block ml-2";
    
    const inputEl = document.createElement("input");
    inputEl.type = "text";
    inputEl.className = "bg-transparent border-b border-yellow-400/50 outline-none text-current w-64 focus:border-yellow-400 transition-all";
    inputEl.autocomplete = "off";
    
    inputWrapper.appendChild(inputEl);
    outputContainer.appendChild(promptSpan);
    outputContainer.appendChild(inputWrapper);
    
    outputContainer.scrollTop = outputContainer.scrollHeight;
    inputEl.focus();
    
    inputEl.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        const val = inputEl.value;
        inputWrapper.innerHTML = "";
        const textSpan = document.createElement("span");
        textSpan.innerText = val;
        inputWrapper.appendChild(textSpan);
        outputContainer.appendChild(document.createTextNode("\n"));
        resolve(val);
      }
    });
  });
};

      /* --- Side Playground Logic --- */
      const openBtn = document.getElementById('open-side-playground');
      const closeBtn = document.getElementById('side-close-btn');
      const drawer = document.getElementById('side-playground-drawer');
      const sideRunBtn = document.getElementById('side-run-btn');
      const sideOutput = document.getElementById('side-output');
      const sideEditorContainer = document.getElementById('side-editor');
      
      let sideEditorView = null;

      if (openBtn && closeBtn && drawer && sideEditorContainer) {
        const initSideEditor = () => {
          if (sideEditorView) return;
          const savedCode = sessionStorage.getItem('haja-playground-code') || "'이름'을 [문자열]인 \"홍길동\"으로 정하자\n틀\"안녕하세요, {'이름'}님!\"을 출력하자";
          sideEditorView = new EditorView({
            doc: savedCode,
            extensions: [
              basicSetup,
              hajaLanguage,
              EditorView.lineWrapping,
              EditorView.theme({
                "&": { height: "100%", fontSize: "14.5px" },
                "&.cm-focused": { outline: "none" },
                ".cm-scroller": { fontFamily: "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace", overflow: "auto" },
                ".cm-gutters": { backgroundColor: "#fbfbfb", borderRight: "1px solid #f0f0f0", color: "#999" }
              }),
              EditorView.updateListener.of((v) => {
                if (v.docChanged) {
                  sessionStorage.setItem('haja-playground-code', v.state.doc.toString());
                }
              })
            ],
            parent: sideEditorContainer
          });
        };

        const openDrawer = (animate = true) => {
          if (!animate) {
            drawer.style.transition = 'none';
            document.body.style.transition = 'none';
          }
          drawer.classList.remove('w-0');
          drawer.classList.add('w-full', 'md:w-1/2');
          document.body.style.width = window.innerWidth > 768 ? '50%' : '100%';
          
          if (!animate) {
            void drawer.offsetWidth; // force reflow
            drawer.style.transition = '';
            document.body.style.transition = '';
          } else {
            document.body.style.transition = 'width 0.3s ease-in-out';
          }
          
          initSideEditor();
          sessionStorage.setItem('haja-playground-open', 'true');
        };

        const closeDrawer = () => {
          drawer.classList.add('w-0');
          drawer.classList.remove('w-full', 'md:w-1/2');
          document.body.style.width = '100%';
          sessionStorage.setItem('haja-playground-open', 'false');
        };

        openBtn.addEventListener('click', () => openDrawer(true));
        closeBtn.addEventListener('click', closeDrawer);

        // Check initial state
        if (sessionStorage.getItem('haja-playground-open') === 'true') {
          openDrawer(false);
        }


        // Run button logic
        sideRunBtn?.addEventListener('click', async () => {
          if (!sideEditorView) return;
          sideRunBtn.innerText = '실행 중...';
          sideOutput.innerText = '';
          let printedSomething = false;
          
          const outputCallback = (msg) => {
            sideOutput.innerText += msg;
            sideOutput.scrollTop = sideOutput.scrollHeight;
            printedSomething = true;
          };
          
          try {
            const code = sideEditorView.state.doc.toString();
            const result = await runHaja(code, createInputCallback(sideOutput), outputCallback);
            if (!printedSomething && !result) {
               sideOutput.innerText += '\n(앗, 출력된 결과가 없어요. "출력하자"를 써보세요.)';
            }
          } catch (err) {
            sideOutput.innerText += "\n" + String(err);
          } finally {
            sideRunBtn.innerText = '실행';
          }
        });

        // Handle resize window restoring 50% width if open
        window.addEventListener('resize', () => {
          if (drawer.classList.contains('md:w-1/2')) {
            document.body.style.width = window.innerWidth > 768 ? '50%' : '100%';
          }
        });
      }

      /* --- Inline Interactive Blocks --- */
      // Find all code blocks inside the article
      const codeBlocks = document.querySelectorAll('.doc-article pre[data-language="plaintext"], .doc-article pre[data-language="haja"]');
      
      codeBlocks.forEach((pre, index) => {
        // Extract raw text
        let rawCode = "";
        const lines = pre.querySelectorAll('.line');
        if (lines.length > 0) {
          rawCode = Array.from(lines).map(l => l.textContent).join('\n');
        } else {
          rawCode = pre.textContent || "";
        }
        rawCode = rawCode.trim();

        // Create container for interactive block
        const container = document.createElement('div');
        container.className = 'not-prose my-8 shadow-md rounded-xl border border-zinc-200 bg-white overflow-hidden flex flex-col';
        
        // Header
        const header = document.createElement('div');
        header.className = 'bg-zinc-50 border-b border-zinc-200 px-4 py-2 flex items-center justify-between';
        
        const dots = document.createElement('div');
        dots.className = 'flex items-center gap-2';
        dots.innerHTML = `
          <div class="w-3 h-3 rounded-full bg-red-400"></div>
          <div class="w-3 h-3 rounded-full bg-amber-400"></div>
          <div class="w-3 h-3 rounded-full bg-green-400"></div>
          <span class="ml-2 text-xs font-semibold text-zinc-400 font-mono">예제 ${index + 1}.haja</span>
        `;
        
        const runBtn = document.createElement('button');
        runBtn.className = 'text-xs bg-blue-50 text-blue-600 hover:bg-blue-100 px-3 py-1.5 rounded-md font-semibold transition-colors flex items-center gap-1 border border-blue-200';
        runBtn.innerHTML = `실행`;
        
        header.appendChild(dots);
        header.appendChild(runBtn);

        // Editor area
        const editorDiv = document.createElement('div');
        editorDiv.className = 'w-full text-[14.5px]';
        
        // Output area
        const outputWrapper = document.createElement('div');
        outputWrapper.className = 'hidden flex-col border-t border-zinc-200 bg-zinc-900';
        
        const outputHeader = document.createElement('div');
        outputHeader.className = 'bg-[#2D2D2D] px-4 py-1.5 border-b border-zinc-700 text-xs font-semibold text-zinc-400 font-mono flex items-center gap-2';
        outputHeader.innerHTML = `<div class="w-2 h-2 rounded-full bg-zinc-500"></div>결과`;
        
        const outputPre = document.createElement('pre');
        outputPre.className = 'p-4 text-[13.5px] text-zinc-300 font-mono whitespace-pre-wrap leading-relaxed m-0';
        
        outputWrapper.appendChild(outputHeader);
        outputWrapper.appendChild(outputPre);

        container.appendChild(header);
        container.appendChild(editorDiv);
        container.appendChild(outputWrapper);

        // Replace <pre> with our interactive container
        pre.parentNode?.replaceChild(container, pre);

        // Init CodeMirror
        const editorView = new EditorView({
          doc: rawCode,
          extensions: [
            basicSetup,
            hajaLanguage,
            EditorView.lineWrapping,
            EditorView.theme({
              "&": { height: "auto", maxHeight: "400px" },
              "&.cm-focused": { outline: "none" },
              ".cm-scroller": { fontFamily: "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace" },
              ".cm-gutters": { backgroundColor: "#fbfbfb", borderRight: "1px solid #f0f0f0", color: "#999" }
            })
          ],
          parent: editorDiv
        });

        // Event logic
        runBtn.addEventListener('click', async () => {
          runBtn.innerText = '실행 중...';
          outputWrapper.classList.remove('hidden');
          outputWrapper.classList.add('flex');
          outputPre.innerText = '';
          
          let printedSomething = false;
          
          const outputCallback = (msg) => {
            outputPre.innerText += msg;
            outputPre.scrollTop = outputPre.scrollHeight;
            printedSomething = true;
          };

          try {
            const code = editorView.state.doc.toString();
            const result = await runHaja(code, createInputCallback(outputPre), outputCallback);
            if (!printedSomething && !result) {
               outputPre.innerText += '\n(앗, 출력된 결과가 없어요. "출력하자"를 써보세요.)';
            }
          } catch (err) {
            outputPre.innerText += "\n" + String(err);
          } finally {
            runBtn.innerHTML = '실행';
          }
        });
      });
    });
  </script>
</Layout>
