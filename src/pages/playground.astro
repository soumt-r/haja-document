---
import Layout from '../layouts/Layout.astro';
---

<Layout title="놀이터 | 하자(Haja) 언어" customMaxWidth="max-w-[1400px]">
  <div class="w-full flex flex-col h-[calc(100vh-220px)] mt-[-20px]">
    <div class="flex items-end justify-between mb-5">
      <div>
        <p class="font-mono text-xs tracking-[0.25em] text-ink-faint uppercase mb-2">Playground</p>
        <h1 class="font-serif text-3xl font-bold tracking-tight">놀이터</h1>
      </div>
      <button id="run-btn" class="hj-run solid !text-sm !px-6 !py-2.5 flex items-center gap-2">
        <span id="run-text">실행하기</span>
        <svg id="run-spinner" class="hidden animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
      </button>
    </div>

    <div class="flex flex-col md:flex-row gap-5 flex-grow min-h-0">
      <!-- Editor -->
      <div class="hj-panel flex-1 min-h-0">
        <div class="hj-panel-head"><span class="hj-tag">main.hj</span></div>
        <div id="editor-container" class="flex-grow w-full overflow-hidden flex flex-col"></div>
      </div>

      <!-- Output -->
      <div class="hj-out flex-1 flex flex-col min-h-0" style="border-radius:2px">
        <div class="hj-out-head">결과</div>
        <div class="flex-grow w-full p-4 overflow-y-auto relative">
          <pre id="output" class="text-[14.5px] whitespace-pre-wrap"></pre>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { runHaja } from '../utils/haja';
    import { EditorView, basicSetup } from "codemirror";
    import { hajaLanguage } from '../utils/haja/cm-language';
    import { hajaTheme } from '../utils/haja/cmTheme';
      import { hajaLinter, hajaAutocomplete } from '../utils/haja/hajaLSP';

    const defaultCode = `"안녕, 세계!"를 출력하자`;

    document.addEventListener("DOMContentLoaded", () => {
      const runBtn = document.getElementById("run-btn");
      const runText = document.getElementById("run-text");
      const runSpinner = document.getElementById("run-spinner");
      const output = document.getElementById("output");
      
      if (output) output.innerText = "실행 결과가 여기에 표시돼요.";

      const editorView = new EditorView({
        doc: defaultCode,
        extensions: [
          basicSetup,
          hajaLanguage,
            hajaLinter,
            hajaAutocomplete,
          EditorView.lineWrapping,
          hajaTheme({ height: "100%", fontSize: "15.5px" })
        ],
        parent: document.getElementById("editor-container")!
      });

      // Run code
            runBtn?.addEventListener("click", async () => {
        if (runText) runText.innerText = "실행 중...";
        runSpinner?.classList.remove("hidden");
        
        try {
          if (output) output.innerText = "";
          const code = editorView.state.doc.toString();
          
          let printedSomething = false;
          
          const outputCallback = (msg) => {
            if (output) {
              output.innerText += msg;
              output.scrollTop = output.scrollHeight;
              printedSomething = true;
            }
          };

          const inputCallback = (promptText) => {
            return new Promise((resolve) => {
              if (!output) { resolve(""); return; }
              const promptSpan = document.createElement("span");
              promptSpan.innerText = promptText;
              promptSpan.className = "hj-prompt";
              
              const inputWrapper = document.createElement("span");
              inputWrapper.className = "relative inline-block ml-2";
              
              const inputEl = document.createElement("input");
              inputEl.type = "text";
              inputEl.className = "hj-input";
              inputEl.autocomplete = "off";
              
              inputWrapper.appendChild(inputEl);
              output.appendChild(promptSpan);
              output.appendChild(inputWrapper);
              
              // Move cursor back to input
              output.scrollTop = output.scrollHeight;
              inputEl.focus();
              
              const onDone = () => {
                const val = inputEl.value;
                inputWrapper.innerHTML = "";
                const textSpan = document.createElement("span");
                textSpan.innerText = val;
                inputWrapper.appendChild(textSpan);
                output.appendChild(document.createTextNode("\n"));
                resolve(val);
              };
              
              inputEl.addEventListener("keydown", (e) => {
                if (e.key === "Enter") onDone();
              });
            });
          };

          const result = await runHaja(code, inputCallback, outputCallback);
          
          // Only show default message if literally nothing was printed via outputCallback OR return
          if (!printedSomething && !result) {
            if (output) output.innerText += '\n(앗, 출력된 결과가 없어요. "출력하자"를 써보세요.)';
          }
        } catch (err) {
          if (output) output.innerText += "\n" + String(err);
        } finally {
          if (runText) runText.innerText = "실행하기";
          runSpinner?.classList.add("hidden");
        }
      });
    });
  </script>
</Layout>
