---
import Layout from '../layouts/Layout.astro';

const principles = [
  { no: '01', title: '읽으면 그대로 뜻이 돼요', body: '코드가 우리말 문장이에요. 영어를 몰라도 무슨 일을 하는지 읽혀요.' },
  { no: '02', title: '객체지향까지 갖췄어요', body: '클래스, 상속, 인터페이스, 예외 처리. 작은 스크립트부터 큰 설계까지 같은 문법으로 가요.' },
  { no: '03', title: '설치 없이 바로 해봐요', body: '브라우저 놀이터에서 예제를 고쳐 가며 실행할 수 있어요.' },
];
---

<Layout title="하자(Haja) 언어" customMaxWidth="max-w-5xl">
  <section class="pt-16 pb-20 grid gap-14 md:grid-cols-[1.1fr_1fr] md:items-center">
    <div>
      <p class="font-mono text-xs tracking-[0.25em] text-ink-faint uppercase mb-8">한국어 프로그래밍 언어</p>
      <h1 class="font-serif font-bold text-5xl sm:text-6xl leading-[1.25] tracking-tight">
        우리말로<br />코딩,<br /><span class="text-seal">하자.</span>
      </h1>
      <p class="mt-10 text-lg text-ink-soft leading-relaxed max-w-md">
        조사와 서술어로 이어지는 우리말 어순 그대로, 프로그램을 써요.
      </p>
      <div class="flex flex-wrap items-center gap-x-8 gap-y-4 mt-10">
        <a href="/docs/intro" class="bg-seal text-paper px-7 py-3 font-semibold hover:bg-seal-deep transition-colors" style="border-radius:2px">
          시작하기
        </a>
        <a href="/playground" class="font-semibold border-b-2 border-ink pb-0.5 hover:text-seal hover:border-seal transition-colors">
          놀이터에서 바로 써보기 →
        </a>
      </div>
    </div>

    <figure class="border border-rule bg-paper-deep/60 p-7 sm:p-9" style="border-radius:2px" aria-label="하자 코드 예시">
      <pre class="font-mono text-[15px] sm:text-base leading-[2.1] whitespace-pre overflow-x-auto"><code><span class="text-ink-faint">(참고) 인사하는 프로그램</span>
<span class="text-ink">'이름'</span><span class="text-seal">을</span> "세상"<span class="text-seal">으로</span> <span class="text-seal font-bold">정하자</span>
<span class="text-ink">'이름'</span><span class="text-seal">을</span> <span class="text-seal font-bold">출력하자</span></code></pre>
      <figcaption class="mt-6 pt-5 border-t border-rule text-sm text-ink-soft leading-relaxed">
        <span class="text-seal font-semibold">주홍</span>으로 표시한 조사와 서술어가 문장의 뼈대예요.
        무엇을, 어떻게, 그리고 <span class="font-semibold text-ink">-하자</span>.
      </figcaption>
    </figure>
  </section>

  <section class="border-t border-rule">
    <ol class="grid md:grid-cols-3">
      {principles.map((p, i) => (
        <li class={`py-10 md:px-8 ${i === 0 ? 'md:pl-0' : 'md:border-l border-rule'} ${i < principles.length - 1 ? 'border-b md:border-b-0 border-rule' : ''}`}>
          <p class="font-mono text-xs text-seal mb-4">{p.no}</p>
          <h2 class="font-serif font-bold text-xl mb-3 leading-snug">{p.title}</h2>
          <p class="text-ink-soft leading-relaxed">{p.body}</p>
        </li>
      ))}
    </ol>
  </section>
</Layout>
